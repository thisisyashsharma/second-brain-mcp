# PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/secondbrain

# MCP Auth Token (Optional for local, recommended for prod)
MCP_AUTH_TOKEN=your-mcp-auth-token-here

# Server port
PORT=3001

# OAuth 2.0 Configuration (Built-in or Auth0)
OAUTH_CLIENT_ID=secondbrain_claude
OAUTH_CLIENT_SECRET=your_secure_client_secret_here
JWT_SECRET=your_secure_jwt_signing_secret_here
# Optional: External JWKS URI (e.g. Auth0/Supabase)
# OAUTH_JWKS_URI=https://<your-tenant>.auth0.com/.well-known/jwks.json
